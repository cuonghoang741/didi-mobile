{
  "name": "codebase-native-app",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --fix",
    "lint:fix": "eslint src --ext ts,tsx --report-unused-disable-directives --fix",
    "prebuild": "npx expo prebuild --skip-dependency-update react-native,react",
    "prebuild:clean": "npx expo prebuild --clean",
    "build:setup": "cd ios && rm -rf Pods Podfile.lock && pod cache clean --all &&  pod install",
    "prepare": "husky",
    "build:ios": "node scripts/update-version.js && eas build --platform ios --auto-submit",
    "build:android": "node scripts/update-version.js && eas build --platform android --auto-submit",
    "doctor": "npx -y expo-doctor",
    "build:ios:local": "rm -rf ./*-*.ipa && eas build --local --platform ios && eas submit --platform ios --path $(ls build-*.ipa) --non-interactive",
    "build:android:local": "rm -rf ./*-*.aab && eas build --local --platform android && eas submit --platform android --path $(ls build-*.aab) --non-interactive",
    "update:production": "eas update --channel production --message \"Production update\"",
    "update:production:android": "eas update --channel production --platform android --message \"Production update (Android only)\"",
    "update:production:ios": "eas update --channel production --platform ios --message \"Production update (iOS only)\"",
    "version:update": "node scripts/update-version.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "yarn lint"
    ]
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ui": "^0.2.0-beta.6",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.0.0",
    "@lottiefiles/dotlottie-react": "^0.17.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.93.2",
    "@tabler/icons-react-native": "^3.35.0",
    "@tanstack/react-query": "^5.90.2",
    "add": "^2.0.6",
    "at-least-node": "^1.0.0",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "expo": "~54.0.11",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.13",
    "expo-device": "^8.0.9",
    "expo-file-system": "~19.0.16",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-media-library": "~18.2.0",
    "expo-router": "~6.0.9",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.8",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-native": "0.81.4",
    "react-native-dropdown-menu": "^2.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-nitro-modules": "^0.29.8",
    "react-native-onesignal": "^5.2.7",
    "react-native-purchases": "^9.5.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.2.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-web": "~0.21.0",
    "react-native-wheel-color-picker": "1.2.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@react-native-community/cli": "^20.0.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "onesignal-expo-plugin": "^2.0.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}